{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aqarly/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ops",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aqarly/ops",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "tenant",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aqarly/tenant",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "housekeeping",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aqarly/housekeeping",
        "dev"
      ],
      "port": 3003
    },
    {
      "name": "field",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aqarly/field",
        "dev"
      ],
      "port": 3004
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "../aqarly-api",
        "run",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "port": 8000
    }
  ]
}
