# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored, so workspace packages are covered too
node_modules/

# pnpm is the package manager for this repo — reject other lockfiles
/package-lock.json
/yarn.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — every app has its own
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
