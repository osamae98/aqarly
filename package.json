{
  "name": "aqarly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aqarly/web dev",
    "dev:web": "pnpm --filter @aqarly/web dev",
    "dev:ops": "pnpm --filter @aqarly/ops dev",
    "dev:tenant": "pnpm --filter @aqarly/tenant dev",
    "dev:housekeeping": "pnpm --filter @aqarly/housekeeping dev",
    "dev:field": "pnpm --filter @aqarly/field dev",
    "build": "pnpm --recursive --stream build",
    "lint": "pnpm --recursive --stream lint",
    "typecheck": "pnpm --recursive --stream typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^6.0.3"
  }
}
